/* For Full-Speed */
uint8_t g_apl_fs_configuration[USB_PUVC_CD_FULL_LEN + ( USB_PUVC_CD_FULL_LEN % 2)] =
{
    USB_CD_BLENGTH,                 /*  0:bLength */
    USB_SOFT_CHANGE,                /*  1:bDescriptorType */
    USB_PUVC_CD_FULL_LEN % USB_W_TOTAL_LENGTH_MASK, /*  2:wTotalLength(L) */
    USB_PUVC_CD_FULL_LEN / USB_W_TOTAL_LENGTH_MASK, /*  3:wTotalLength(H) */
    2,                              /*  4:bNumInterfaces */
    1,                              /*  5:bConfigurationValue */
    0,                              /*  6:iConfiguration */
    USB_CF_RESERVED | USB_CF_SELFP, /*  7:bmAttributes */
    (10 / 2),                       /*  8:MAXPower (2mA unit) */

    /* Interface Association Descriptor (IAD) */
    0x08,                           /*  0:bLength */
    USB_IAD_TYPE,                   /*  1:bDescriptorType */
    0x00,                           /*  2:bFirstInterface */
    0x02,                           /*  3:bInterfaceCount */
    USB_IFCLS_VID,                  /*  4:bFunctionClass  */
    0x03,                           /*  5:bFunctionSubClass */
    0x00,                           /*  6:bFunctionProtocol */
    0x00,                           /*  7:iFunction */

    /* Interface Descriptor #0: Control */
    USB_ID_BLENGTH,                 /*  0:bLength */
    USB_DT_INTERFACE,               /*  1:bDescriptor */
    0x00,                           /*  2:bInterfaceNumber */
    0x00,                           /*  3:bAlternateSetting */
    0x00,                           /*  4:bNumEndpoints */
    USB_IFCLS_VID,                  /*  5:bInterfaceClass */
    USB_UVC_CONTROL,                /*  6:bInterfaceSubClass */
    0x00,                           /*  7:bInterfaceProtocol */
    0x00,                           /*  8:iInterface */

    /* Video Control Interface Header Descriptor */
    0x0D,                           /*  0:bLength (13 bytes) */
    USB_UVC_CS_INTERFACE,           /*  1:bDescriptorType */
    USB_UVC_CS_VC_HEADER,           /*  2:bDescriptorSubtype */
    (USB_UVC_VERSION_100 & (uint8_t) USB_UCHAR_MAX),                   /*  3:bcdUVC[L] (UVC Version 1.00) */
    ((uint8_t) (USB_UVC_VERSION_100 >> 8) & (uint8_t) USB_UCHAR_MAX),  /*  4:bcdUVC[H] (UVC Version 1.00) */
    (USB_UVC_VC_HEADER_TOTAL_LENGTH & (uint8_t) USB_UCHAR_MAX),                 /*  5:TotalLength[L] (0x0033 (51) bytes) */
    ((uint8_t) (USB_UVC_VC_HEADER_TOTAL_LENGTH >> 8) & (uint8_t) USB_UCHAR_MAX),/*  6:TotalLength[H] (0x0033 (51) bytes) */
    (USB_UVC_CLOCK_FREQUENCY_100_MHZ & (uint8_t) USB_UCHAR_MAX),                  /*  7:dwClockFreq[LL] (100 MHz) */
    ((uint8_t) (USB_UVC_CLOCK_FREQUENCY_100_MHZ >> 8) & (uint8_t) USB_UCHAR_MAX), /*  8:dwClockFreq[LH] (100 MHz) */
    ((uint8_t) (USB_UVC_CLOCK_FREQUENCY_100_MHZ >> 16) & (uint8_t) USB_UCHAR_MAX),/*  9:dwClockFreq[HL] (100 MHz) */
    ((uint8_t) (USB_UVC_CLOCK_FREQUENCY_100_MHZ >> 24) & (uint8_t) USB_UCHAR_MAX),/*  10:dwClockFreq[HH] (100 MHz) */
    0x01,                           /*  11:bInCollection (1 VideoStreaming interface) */
    0x01,                           /*  12:baInterfaceNr[1] */

    /* Video Control Input Terminal Descriptor */
    0x12,                           /* bLength */
    USB_UVC_CS_INTERFACE,           /* bDescriptorType */
    0x02,                           /* bDescriptorSubtype (Input Terminal) */
    0x01,                           /* bTerminalID */
    0x01, 0x02,                     /* wTerminalType (ITT_CAMERA) */
    0x00,                           /* bAssocTerminal */
    0x00,                           /* iTerminal */
    0x00, 0x00,                     /* wObjectiveFocalLengthMin */
    0x00, 0x00,                     /* wObjectiveFocalLengthMax */
    0x00, 0x00,                     /* wOcularFocalLength */
    0x03,                           /* bControlSize */
    0x00, 0x00, 0x00,               /* bmControls */

    /* Video Control Processing Unit Descriptor */
    0x0B,                           /* bLength */
    USB_UVC_CS_INTERFACE,           /* bDescriptorType */
    0x05,                           /* bDescriptorSubtype (Processing Unit) */
    0x02,                           /* bUnitID */
    0x01,                           /* bSourceID */
    0x00, 0x00,                     /* wMaxMultiplier */
    0x02,                           /* bControlSize */
    0x00, 0x00,                     /* bmControls */
    0x00,                           /* iProcessing */

    /* Video Control Output Terminal Descriptor */
    0x09,                           /* bLength */
    USB_UVC_CS_INTERFACE,           /* bDescriptorType */
    0x03,                           /* bDescriptorSubtype (Output Terminal) */
    0x04,                           /* bTerminalID */
    0x01, 0x01,                     /* wTerminalType (TT_STREAMING) */
    0x00,                           /* bAssocTerminal */
    0x02,                           /* bSourceID */
    0x00,                           /* iTerminal */

    /* Interface Descriptor #1 */
    0x09,                           /*  0:bLength */
    USB_DT_INTERFACE,               /*  1:bDescriptorType */
    0x01,                           /*  2:bInterfaceNumber */
    0x00,                           /*  3:bAlternateSetting */
    0x00,                           /*  4:bNumEndpoints */
    USB_IFCLS_VID,                  /*  5:bInterfaceClass */
    USB_UVC_STREAMING,              /*  6:bInterfaceSubClass */
    0x00,                           /*  7:bInterfaceProtocol */
    0x00,                           /*  8:iInterface */

    /* VC-Specific VS Video Input Header Descriptor */
    0x0E,                           /*  0:bLength */
    USB_UVC_CS_INTERFACE,           /*  1:bDescriptorType (Video Streaming Interface) */
    USB_UVC_CS_VS_INPUT_HEADER,     /*  2:bDescriptorSubtype (Input Header) */
    0x01,                           /*  3:bNumFormats */
    (USB_UVC_VS_HEADER_TOTAL_LENGTH & (uint8_t) USB_UCHAR_MAX),                   /*  4:wTotalLength[L] (0x004B (75) bytes) */
    ((uint8_t) (USB_UVC_VS_HEADER_TOTAL_LENGTH >> 8) & (uint8_t) USB_UCHAR_MAX),  /*  5:wTotalLength[H] (0x004B (75) bytes) */
    USB_EP_IN | USB_EP1,            /*  6:bEndpointAddress (Direction=IN  EndpointID=1) */
    0x00,                           /*  7:bmInfo (Dynamic Format Change not supported) */
    0x04,                           /*  8:bTerminalLink (Output Terminal ID 4) */
    0x00,                           /*  9:bStillCaptureMethod (None) */
    0x00,                           /*  10:nbTriggerSupport (Hardware Triggering not supported) */
    0x00,                           /*  11:bTriggerUsage (Host will initiate still image capture) */
    0x01,                           /*  12:bControlSize (1 bytes each) */
    0x00,                           /*  13:Video Payload Format 1 (All no) */

    /* Video Streaming MJPEG Format Type Descriptor */
    0x0B,                           /*  1:bLength (11 bytes) */
    USB_UVC_CS_INTERFACE,           /*  2:bDescriptorType (Video Streaming Interface) */
    USB_UVC_CS_VS_FORMAT_MJPEG,     /*  3:bDescriptorSubtype (Format MJPEG) */
    0x01,                           /*  4:bFormatIndex (1) */
    0x01,                           /*  5:bNumFrameDescriptors (1) */
    0x00,                           /*  6:bmFlags (Sample size is not fixed) */
    0x01,                           /*  7:bDefaultFrameIndex (1) */
    0x00,                           /*  8:bAspectRatioX */
    0x00,                           /*  9:bAspectRatioY */
    0x00,                           /*  10:bmInterlaceFlags                         */
                                    /*    D0 IL stream or variable:0 (no)           */
                                    /*    D1 Fields per frame     :0 (2 fields)     */
                                    /*    D2 Field 1 first        :0 (no)           */
                                    /*    D3 Reserved             :0                */
                                    /*    D4..5 Field pattern     :0 (Field 1 only) */
                                    /*    D6..7 Display Mode      :0 (Bob only)     */
    0x00,                           /*  11:bCopyProtect (No restrictions) */

    /* Video Streaming MJPEG Frame Type Descriptor */
    USB_UVC_MJPEG_FRAME_TYPE_DESCRIPTOR_LENGTH,   /*  0:bLength (50 bytes)*/
    USB_UVC_CS_INTERFACE,           /*  1:bDescriptorType (Video Streaming Interface) */
    USB_UVC_CS_VS_FRAME_MJPEG,      /*  2:bDescriptorSubtype (MJPEG Frame Type) */
    0x01,                           /*  3:bFrameIndex */
    0x00,                           /*  4:bmCapabilities */

    (USB_UVC_FRAME_WIDTH_640 & (uint8_t) USB_UCHAR_MAX),                    /*  5:wWidth[L] (640) */
    ((uint8_t) (USB_UVC_FRAME_WIDTH_640 >> 8) & (uint8_t) USB_UCHAR_MAX),   /*  6:wWidth[H] (640) */

    (USB_UVC_FRAME_HEIGHT_480 & (uint8_t) USB_UCHAR_MAX),                   /*  7:wHeight[L] (480) */
    ((uint8_t) (USB_UVC_FRAME_HEIGHT_480 >> 8) & (uint8_t) USB_UCHAR_MAX),  /*  8:wHeight[H] (480) */

    (USB_UVC_MIN_BIT_RATE_FS & (uint8_t) USB_UCHAR_MAX),                  /*  9:dwMinBitRate[LL] (24576000 bps -> 3.72 MB/s) */
    ((uint8_t) (USB_UVC_MIN_BIT_RATE_FS >> 8) & (uint8_t) USB_UCHAR_MAX), /*  10:dwMinBitRate[LH] (24576000 bps -> 3.72 MB/s) */
    ((uint8_t) (USB_UVC_MIN_BIT_RATE_FS >> 16) & (uint8_t) USB_UCHAR_MAX),/*  11:dwMinBitRate[HL] (24576000 bps -> 3.72 MB/s) */
    ((uint8_t) (USB_UVC_MIN_BIT_RATE_FS >> 24) & (uint8_t) USB_UCHAR_MAX),/*  12:dwMinBitRate[HH] (24576000 bps -> 3.72 MB/s) */

    (USB_UVC_MAX_BIT_RATE_FS & (uint8_t) USB_UCHAR_MAX),                  /*  13:dwMaxBitRate[LL] (147456000 bps -> 18.432 MB/s) */
    ((uint8_t) (USB_UVC_MAX_BIT_RATE_FS >> 8) & (uint8_t) USB_UCHAR_MAX), /*  14:dwMaxBitRate[LH] (147456000 bps -> 18.432 MB/s) */
    ((uint8_t) (USB_UVC_MAX_BIT_RATE_FS >> 16) & (uint8_t) USB_UCHAR_MAX),/*  15:dwMaxBitRate[HL] (147456000 bps -> 18.432 MB/s) */
    ((uint8_t) (USB_UVC_MAX_BIT_RATE_FS >> 24) & (uint8_t) USB_UCHAR_MAX),/*  16:dwMaxBitRate[HH] (147456000 bps -> 18.432 MB/s) */

