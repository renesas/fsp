    USB_DT_ENDPOINT,                /*  1:bDescriptorType */
    USB_EP_IN | USB_EP1,            /*  2:bEndpointAddress (IN transfer, Endpoint Number 1) */
    0x05,                           /*  3:bmAttributes : bmAttributes (Isochronous, Async, DataEndpoint) */
    (USB_PUVC_MAX_PACKET_SIZE_128 & (uint8_t) USB_UCHAR_MAX),                  /*  4:wMaxPacketSize[L] */
    ((uint8_t) (USB_PUVC_MAX_PACKET_SIZE_128 >> 8) & (uint8_t) USB_UCHAR_MAX), /*  5:wMaxPacketSize[H] */
    0x01,                           /* 6:bInterval (1 microframe -> 0.125 ms) */

        /* Interface Descriptor */
    0x09,                           /*  0:bLength */
    USB_DT_INTERFACE,               /*  1:bDescriptorType */
    0x01,                           /*  2:bInterfaceNumber */
    0x02,                           /*  3:bAlternateSetting */
    0x01,                           /*  4:bNumEndpoints */
    USB_IFCLS_VID,                  /*  5:bInterfaceClass */
    USB_UVC_STREAMING,              /*  6:bInterfaceSubClass (VideoStream) */
    0x00,                           /*  7:bInterfaceProtocol */
    0x00,                           /*  8:iInterface */

    /* Endpoint Descriptor */
    0x07,                           /*  0:bLength */
    USB_DT_ENDPOINT,                /*  1:bDescriptorType */
    USB_EP_IN | USB_EP1,            /*  2:bEndpointAddress (IN transfer, Endpoint Number 1) */
    0x05,                           /*  3:bmAttributes : bmAttributes (Isochronous, Async, DataEndpoint) */
    (USB_PUVC_MAX_PACKET_SIZE_1024 & (uint8_t) USB_UCHAR_MAX),                  /*  4:wMaxPacketSize[L] */
    ((uint8_t) (USB_PUVC_MAX_PACKET_SIZE_1024 >> 8) & (uint8_t) USB_UCHAR_MAX), /*  5:wMaxPacketSize[H] */
    0x01,                           /* 6:bInterval (1 microframe -> 0.125 ms) */
#else
    /* Interface Descriptor */
    0x09,                           /*  0:bLength */
    USB_DT_INTERFACE,               /*  1:bDescriptorType */
    0x01,                           /*  2:bInterfaceNumber */
    0x01,                           /*  3:bAlternateSetting */
    0x01,                           /*  4:bNumEndpoints */
    USB_IFCLS_VID,                  /*  5:bInterfaceClass */
    USB_UVC_STREAMING,              /*  6:bInterfaceSubClass (VideoStream) */
    0x00,                           /*  7:bInterfaceProtocol */
    0x00,                           /*  8:iInterface */

    /* Endpoint Descriptor */
    0x07,                           /*  0:bLength */
    USB_DT_ENDPOINT,                /*  1:bDescriptorType */
    USB_EP_IN | USB_EP1,            /*  2:bEndpointAddress (IN transfer, Endpoint Number 1) */
    0x05,                           /*  3:bmAttributes : bmAttributes (Isochronous, Async, DataEndpoint) */
    (USB_PUVC_MAX_PACKET_SIZE_1024 & (uint8_t) USB_UCHAR_MAX),                  /*  4:wMaxPacketSize[L] */
    ((uint8_t) (USB_PUVC_MAX_PACKET_SIZE_1024 >> 8) & (uint8_t) USB_UCHAR_MAX), /*  5:wMaxPacketSize[H] */
    0x01,                           /* 6:bInterval (1 microframe -> 0.125 ms) */
#endif
};

